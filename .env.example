# 네이버 오픈 API (데이터랩 검색어 트렌드 / 쇼핑검색) - https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 쇼핑커넥트 제휴 딥링크 변환 템플릿. {url} 플레이스홀더를 포함해서
# 파트너센터에서 안내하는 실제 변환 방식에 맞게 채워넣을 것.
# 예: NAVER_SHOPPING_AFFILIATE_LINK_TEMPLATE="https://partner.example.com/redirect?url={url}"
NAVER_SHOPPING_AFFILIATE_LINK_TEMPLATE=

# 쿠팡 파트너스 Open API - https://partners.coupang.com
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 콘텐츠 생성 백엔드 선택: claude_print(기본값) | anthropic_api | template
#   claude_print - 로컬에 로그인된 Claude Code CLI(`claude -p`)를 사용.
#                  Pro/Max 구독 사용량을 그대로 쓰므로 API 키가 필요 없다.
#                  사전에 터미널에서 `claude` 실행 후 로그인이 되어 있어야 한다.
#   anthropic_api - 아래 ANTHROPIC_API_KEY로 메터드 과금 API를 사용.
#   template      - 오프라인/테스트용 결정론적 템플릿.
LLM_BACKEND=claude_print
CLAUDE_MODEL=sonnet

# Anthropic (Claude) API 키 - LLM_BACKEND=anthropic_api일 때만 필요.
ANTHROPIC_API_KEY=

# Google Blogger (OAuth2 refresh token 방식 - 비대화형 환경용)
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
