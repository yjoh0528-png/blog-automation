# 네이버 오픈 API (데이터랩 검색어 트렌드 / 쇼핑검색) - https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 쇼핑커넥트 제휴 딥링크 변환 템플릿. {url} 플레이스홀더를 포함해서
# 파트너센터에서 안내하는 실제 변환 방식에 맞게 채워넣을 것.
# 예: NAVER_SHOPPING_AFFILIATE_LINK_TEMPLATE="https://partner.example.com/redirect?url={url}"
NAVER_SHOPPING_AFFILIATE_LINK_TEMPLATE=

# 쿠팡 파트너스 Open API - https://partners.coupang.com
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Anthropic (Claude) API - 콘텐츠 생성. 미설정 시 템플릿 폴백을 사용한다.
ANTHROPIC_API_KEY=

# Google Blogger (OAuth2 refresh token 방식 - 비대화형 환경용)
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
